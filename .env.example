# Database (PostgreSQL em produção; SQLite dev.db em desenvolvimento local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth JWT Secret (Obrigatório: gere com openssl rand -hex 32)
JWT_SECRET="gere_um_segredo_jwt_exclusivo_com_openssl_rand_hex_32"

# Segredo de Setup de Super Administrador (Obrigatório: chave distinta para proteção de setup)
ADMIN_SETUP_SECRET="gere_uma_chave_setup_exclusiva_com_openssl_rand_hex_32"

# Chave de Criptografia AES-256 de Dados OAuth em Repouso (Obrigatório: chave distinta de 32 bytes)
DATA_ENCRYPTION_KEY="gere_uma_chave_aes_exclusiva_com_openssl_rand_hex_32"

# Mercado Pago Integration (Pix & Cartão de Crédito)
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY=""
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=""

# Mercado Pago Marketplace OAuth (Split de Pagamentos)
MERCADO_PAGO_CLIENT_ID=""
MERCADO_PAGO_CLIENT_SECRET=""
NEXT_PUBLIC_MP_CLIENT_ID=""

# Segredo de Validação de Webhook do Mercado Pago (obtido no painel de Webhooks do MP)
MERCADO_PAGO_WEBHOOK_SECRET=""

# Base URL (ex: https://fralda.online ou https://seu-app.vercel.app)
NEXT_PUBLIC_APP_URL="https://fralda.online"

# Envio de E-mails Transacionais (Recuperação de Senha via Resend — opcional)
# Obtenha sua chave gratuita em https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="Fralda Online <suporte@fralda.online>"

# Rate Limiting Distribuído na Borda (Upstash Redis — Opcional em dev; Recomendado para produção serverless)
# Crie seu banco Serverless gratuito em https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Segredo de Execução de Jobs Cron de Manutenção / LGPD (Ex: expurgo de dados)
CRON_SECRET="gere_um_segredo_para_execucao_de_rotinas_cron_seguras"
