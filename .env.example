# Database (PostgreSQL em produção; SQLite dev.db em desenvolvimento local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth JWT Secret (Obrigatório: gere uma chave aleatória com mais de 32 caracteres em produção)
JWT_SECRET="gere_um_segredo_criptografico_forte_com_openssl_rand_hex_32"

# Chave de Criptografia de Dados (Opcional: se omitida, o sistema usa JWT_SECRET para derivar a chave AES-256)
DATA_ENCRYPTION_KEY="chave_hex_de_32_bytes_para_criptografia_aes256"

# Mercado Pago Integration (Pix & Cartão de Crédito)
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY=""
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=""

# Mercado Pago Marketplace OAuth (Split de Pagamentos)
MERCADO_PAGO_CLIENT_ID=""
MERCADO_PAGO_CLIENT_SECRET=""
NEXT_PUBLIC_MP_CLIENT_ID=""

# Segredo de Validação de Webhook do Mercado Pago (obtido no painel de Webhooks do MP)
MERCADO_PAGO_WEBHOOK_SECRET=""

# Base URL (ex: https://fraldaonline.com.br ou https://seu-app.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
