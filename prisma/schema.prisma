datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String   // Hash bcrypt
  role         String   @default("USER") // "USER" | "ADMIN"
  tokenVersion Int      @default(1) // Controle de revogação de sessão / invalidação de JWT em todos os dispositivos
  events       Event[]
  createdAt    DateTime @default(now())
}

model Event {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String         @unique // Ex: "cha-do-leo", "revelacao-maya-ou-noah"
  eventType       String         @default("REVELACAO") // "REVELACAO" | "FRALDA" | "AMBOS"
  babyName        String?        // Nome do bebê ou nomes prováveis
  boyName         String?        // Nome se for menino (ex: "Arthur")
  girlName        String?        // Nome se for menina (ex: "Helena")
  parentsNames    String         // Ex: "Mariana e Rafael"
  eventDate       DateTime
  coverImageUrl   String?
  storyMessage    String?
  themeColor      String         @default("#38BDF8") // Azul, Rosa, Neutro
  revealedGender  String?        // "BOY" | "GIRL" | null (liberado após a revelação)
  pixKey          String?        // Chave Pix dos pais para saque (legado/reserva)
  
  // Integração Mercado Pago Marketplace (Split de Pagamentos)
  mpUserId        String?        // ID da conta dos pais no Mercado Pago
  mpAccessToken   String?        // Access token dos pais para transacionar em nome deles
  mpRefreshToken  String?        // Refresh token para renovação
  mpPublicKey     String?        // Public key do seller (se fornecida)
  mpConnected     Boolean        @default(false) // Se os pais conectaram a conta MP
  feePayer        String         @default("GUEST") // "GUEST" (repassa p/ convidado) | "PARENTS" (pais assumem)
  
  items           GiftItem[]
  orders          Order[]
  guestMessages   GuestMessage[]
  pollVotes       PollVote[]
  createdAt       DateTime       @default(now())
}

model GiftItem {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String   // "Pacote Fralda G"
  description String?
  price       Float
  imageUrl    String
  category    String   // "fraldas", "higiene", "brincadeiras"
  active      Boolean  @default(true)
  orders      Order[]
  createdAt   DateTime @default(now())
}

model PollVote {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  voterName String
  guess     String   // "BOY" | "GIRL"
  createdAt DateTime @default(now())
}

model Order {
  id             String        @id @default(uuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  giftItemId     String?
  giftItem       GiftItem?     @relation(fields: [giftItemId], references: [id], onDelete: SetNull)
  amount         Float
  payerName      String
  payerEmail     String
  payerPhone     String?
  payerCpf       String?       // CPF do pagador (limpo, 11 dígitos)
  payerMessage   String?
  pollGuess      String?       // Se o presente veio com palpite no bolão ("BOY" | "GIRL")
  paymentMethod  String        @default("PIX")
  mpPaymentId    String?       @unique
  status         String        @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  netAmount      Float?        // Valor líquido do presente (ex: R$ 50,00)
  feeAmount      Float?        // Taxa total cobrada/descontada (ex: R$ 2,99)
  platformFee    Float?        // Comissão de 4,99% da plataforma retida no split
  gatewayFee     Float?        // Taxa estimada do MP (0,99% Pix ou 3,99% Cartão)
  feePayer       String        @default("GUEST") // "GUEST" ou "PARENTS"
  guestMessage   GuestMessage?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model GuestMessage {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String
  message   String
  createdAt DateTime @default(now())
}
